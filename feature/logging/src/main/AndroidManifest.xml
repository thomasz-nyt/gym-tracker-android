<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ADR-0010. A rest is 90 seconds, so an inexact alarm that lands minutes late is the
      same as not firing. USE_EXACT_ALARM is granted on install for sideloaded apps, which
      is how this household installs; publishing to Play would require moving to a
      foreground service instead.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ADR-0049: the rest cue is a haptic pulse (and an optional tone). A normal permission, no
         prompt; the cue is not a notification and does not wait on POST_NOTIFICATIONS. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <receiver
            android:name="com.gymtracker.feature.logging.rest.RestOverReceiver"
            android:exported="false" />

        <!--
          US-54: the notification's LOG SET / SKIP REST buttons. Not exported — the only
          thing that ever sends to it is our own PendingIntent.
        -->
        <receiver
            android:name="com.gymtracker.feature.logging.rest.RestActionReceiver"
            android:exported="false" />
        <!-- ADR-0049: the ten-second cue's own wakeup, the same shape as RestOverReceiver's. -->
        <receiver
            android:name="com.gymtracker.feature.logging.rest.RestCueReceiver"
            android:exported="false" />
    </application>

</manifest>
