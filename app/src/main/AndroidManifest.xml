<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      M5, US-21 (`specs/health-connect.md` §Permissions): read-only, one at a time, each
      requested only once the member turns the toggle on. No write permission exists, ever
      (§"We never write").
    -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!--
      Package-visibility (Android 11+): without this, PackageManager cannot see the Health
      Connect provider at all, and `HealthConnectClient.getSdkStatus` reads "not installed"
      even when it is — which would be indistinguishable from the real Unavailable case in
      the UI, but wrong for a reason nobody could diagnose from the app alone.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!--
      US-46, ADR-0039: live heart rate from a directly-paired band — not Health Connect.
      `neverForLocation` on BLUETOOTH_SCAN drops the ACCESS_FINE_LOCATION requirement that
      scanning would otherwise carry on API 26–30; this app never derives location from a
      scan result, so the flag is honest, and it is the reason this feature is gated to
      API 31+ rather than supporting the app's full min-SDK 26 floor. `usesPermissionFlags`
      only affects behaviour on API 31+; API 30 and below ignore it and would need
      ACCESS_FINE_LOCATION regardless, which is exactly why the feature stays unavailable
      there instead of requesting it.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Class names are fully qualified on purpose. A leading-dot name resolves against the
      module's `namespace` (com.gymtracker), not against the package the Kotlin files are
      actually in (com.gymtracker.app), and the mismatch only shows up as a
      ClassNotFoundException at launch.
    -->
    <application
        android:name="com.gymtracker.app.GymTrackerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymTracker">

        <activity
            android:name="com.gymtracker.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GymTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          US-22: without this, Health Connect refuses every read outright — found live on
          device (API 36) as `IllegalStateException: Incorrect health permission state,
          likely because the calling application's manifest does not specify handling
          android.intent.action.VIEW_PERMISSION_USAGE with
          android.intent.category.HEALTH_PERMISSIONS`. Both intent filters point at the same
          activity: VIEW_PERMISSION_USAGE is what the Android 14+ platform module launches
          from its own permissions screen; SHOW_PERMISSIONS_RATIONALE is the pre-14
          Health Connect app's equivalent.
        -->
        <activity
            android:name="com.gymtracker.app.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.GymTracker">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
