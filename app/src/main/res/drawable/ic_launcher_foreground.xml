<?xml version="1.0" encoding="utf-8"?>
<!--
  Rep, the mascot, as the launcher icon's foreground layer.

  Traced by hand from the source SVG rather than converted by a tool, because that source uses
  three things a VectorDrawable has no equivalent for: `<circle>` elements (redrawn here as arc
  paths), CSS classes for stroke colour and width (inlined per path), and a viewBox whose origin
  is negative (kept, by putting the artwork in a group that translates it).

  The adaptive-icon canvas is 108x108, and the guaranteed-visible region is a **circle of
  diameter 66** centred on it — not the 72x72 square, which is the mistake the first version of
  this file made: at scale 1.25 the sweatband's tail sat inside the square but outside the
  circle, and a circular launcher mask sheared it off, leaving a mark that read as an eye rather
  than a head.

  So the fit is computed against that circle. Including stroke width the artwork spans
  x -21.5..35 and y -16.5..23.5, whose centre is (6.75, 3.5) and whose half-diagonal at scale
  0.9 is sqrt(25.4^2 + 18^2) = 31.1 — inside 33, with a little to spare. The translate below is
  (54 - 6.75*0.9, 54 - 3.5*0.9), which centres that box on the canvas rather than centring the
  head and letting the tail hang off one side.

  The band is the identity. It is the only part that ever changes between poses in the source
  drawings, so it is the part the icon must not crop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="47.9"
        android:translateY="50.85"
        android:scaleX="0.9"
        android:scaleY="0.9">

        <!-- Head, in profile: a circle centred (0,2), radius 19, drawn as two half-arcs. -->
        <path
            android:pathData="M0,-17 a19,19 0 1,0 0,38 a19,19 0 1,0 0,-38"
            android:strokeColor="#FBFBF9"
            android:strokeWidth="5" />

        <!-- The nose bump. -->
        <path
            android:pathData="M-18,0 q-7,4 -2,9"
            android:strokeColor="#FBFBF9"
            android:strokeWidth="5"
            android:strokeLineCap="round" />

        <!-- One eye, filled. -->
        <path
            android:pathData="M-8,-5 a3,3 0 1,0 0,6 a3,3 0 1,0 0,-6"
            android:fillColor="#FBFBF9" />

        <!-- The sweatband across the brow. -->
        <path
            android:pathData="M-17.5,-5 A19,19 0 0 1 14,-11"
            android:strokeColor="#D19A00"
            android:strokeWidth="7"
            android:strokeLineCap="round" />

        <!-- Its tail, which is what gives the mark its direction. -->
        <path
            android:pathData="M14,-10.5 q15,2 18,10"
            android:strokeColor="#D19A00"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
    </group>
</vector>
